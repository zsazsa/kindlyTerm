[Desktop Entry]
Type=Application
Version=1.5
Name=kindlyTerm
GenericName=Terminal
Comment=GPU-accelerated terminal with a Control Deck of saved commands
Exec=kindlyterm
TryExec=kindlyterm
Icon=kindlyterm
Terminal=false
Categories=System;TerminalEmulator;
Keywords=term;terminal;shell;console;command;ssh;prompt;kind;kindly;
StartupNotify=true
StartupWMClass=kindlyterm
Actions=new-window;deck;

[Desktop Action new-window]
Name=New Window
Exec=kindlyterm

[Desktop Action deck]
Name=Open Control Deck
Exec=kindlyterm --deck
